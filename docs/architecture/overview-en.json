  "cards": [
    {
      "dot": "cyan",
      "title": "What the kit supplies",
      "items": [
        "Read one authorized source locally; preserve measurement/retrieval times, gaps and coverage.",
        "Expose a read-only MCP tool to your trusted agent. The default is synthetic and needs no account."
      ]
    },
    {
      "dot": "violet",
      "title": "Agent and report",
      "items": [
        "Deeper interpretation, user-provided context and habit suggestions belong to the external agent.",
        "Reports distinguish conclusions, evidence, comparable history and unknowns. No diagnosis or treatment."
      ]
    },
    {
      "dot": "rose",
      "title": "Safety and present limits",
      "items": [
        "One trusted local user. TTY authorization, encrypted vault, plaintext report exports. The agent receives health information: review trust and permissions.",
        "Device sync is outside this kit and may be incomplete. WHOOP official OAuth/API; Garmin unofficial route.",
        "No built-in long-term health record, automatic multi-device merging or scheduled delivery. Motion is not live health data."
      ]
    }
  ]
