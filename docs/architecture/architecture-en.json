  "cards": [
    {
      "dot": "cyan",
      "title": "Invocation and outputs",
      "items": [
        "Agents call the read-only MCP over stdio; CLI also runs collect/read directly.",
        "The summary returns to its caller. read --checkpoint is a separate offline path, not the MCP default.",
        "Motion illustrates authored relationships, not live requests, sync status or data acceptance."
      ]
    },
    {
      "dot": "rose",
      "title": "Authorization stays local",
      "items": [
        "Explicit auth uses a local TTY. No credentials are accepted in MCP tool arguments.",
        "WHOOP: official browser OAuth + loopback callback. Garmin: unofficial sign-in, with MFA when required.",
        "Live startup asks for the vault passphrase again. Health reads may refresh and persist tokens.",
        "WHOOP stores its app secret and tokens; Garmin stores session tokens, not password or MFA. Authorization alone is not a verified real read."
      ]
    },
    {
      "dot": "amber",
      "title": "Data and trust boundary",
      "items": [
        "Self-hosted under one trusted OS account; no public HTTP or multi-user service.",
        "The vault passphrase is not saved; an unlocked process can decrypt. Checkpoints are plaintext health summaries.",
        "This is the current CLI wiring. Live-account acceptance, scheduling and delivery require separate verification."
      ]
    }
  ]
